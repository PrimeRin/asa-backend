<!DOCTYPE html>
<html>
<body>
<p>Dear <%= @icbs_user_name %>, </p>
<p>
  <%= @message %>
</p>
<br>
<p>Please click the following button to check the status.</p>
      
      <div style="margin: 20px 0; text-align: center;">
        <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; width: auto;">
            <tr>
                <td style="font-family: Arial, sans-serif; font-size: 16px; vertical-align: top; background-color: #3498db; border-radius: 4px; text-align: center;">
                    <a href="<%= @url %>" target="_blank" style="display: inline-block; color: #ffffff; background-color: #3498db; border: solid 1px #3498db; border-radius: 4px; box-sizing: border-box; cursor: pointer; text-decoration: none; font-size: 16px; font-weight: bold; margin: 0; padding: 12px 24px; text-transform: capitalize; border-color: #3498db;">
                        Login ASA
                    </a>
                </td>
            </tr>
        </table>
      </div>
<p>Thank you.</p>
</body>
</html>
