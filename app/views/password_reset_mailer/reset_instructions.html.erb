<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
      <h2 style="color: #2c3e50;">Password Reset Instructions</h2>
      
      <p>Hello <%= @full_name %>,</p>
      
      <p>We received a request to reset your password. Click the button below to proceed:</p>
      
      <div style="margin: 20px 0; text-align: center;">
        <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; width: auto;">
            <tr>
                <td style="font-family: Arial, sans-serif; font-size: 16px; vertical-align: top; background-color: #3498db; border-radius: 4px; text-align: center;">
                    <a href="<%= @reset_url %>" target="_blank" style="display: inline-block; color: #ffffff; background-color: #3498db; border: solid 1px #3498db; border-radius: 4px; box-sizing: border-box; cursor: pointer; text-decoration: none; font-size: 16px; font-weight: bold; margin: 0; padding: 12px 24px; text-transform: capitalize; border-color: #3498db;">
                        Reset Password
                    </a>
                </td>
            </tr>
        </table>
      </div>
      
      <p>If you didn't request this password reset, please ignore this email.</p>
      
      <p>Thank you.</p>
    </div>
  </body>
</html>
